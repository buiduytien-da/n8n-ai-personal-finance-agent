    {
      "parameters": {
        "jsCode": "// 1. Lấy nội dung từ node AI (Xử lý trường hợp input rỗng)\nconst rawContent = $input.first().json.text || $input.first().json.content || $input.first().json.output || \"\";\n\n// 2. Tẩy rửa Markdown (Quan trọng: AI hay kẹp ```json ở đầu cuối)\n// Xóa hết các ký tự ```json, ``` và khoảng trắng thừa\nconst cleanString = rawContent.replace(/```json|```/g, \"\").trim();\n\n// 3. Lọc lấy khối JSON\nconst jsonMatch = cleanString.match(/\\{[\\s\\S]*\\}/);\n\nif (jsonMatch) {\n  try {\n    let cleanData = JSON.parse(jsonMatch[0]);\n\n    // 4. Chuẩn hóa dữ liệu (Data Normalization)\n    // Giúp Node Switch phía sau đỡ bị lỗi do viết hoa/thường (VD: \"write\" vs \"Write\")\n    if (cleanData.intent) {\n        cleanData.intent = cleanData.intent.toString().toLowerCase().trim();\n    }\n\n    // Quan trọng cho nhánh Thu nhập: Chuẩn hóa loại giao dịch\n    if (cleanData.data && cleanData.data.Loai) {\n        // Đưa về lowercase để dễ so sánh: \"Thu nhập\" -> \"thu nhập\"\n        cleanData.data.Loai_Raw = cleanData.data.Loai; // Giữ bản gốc để hiển thị đẹp\n        cleanData.data.Loai_Slug = cleanData.data.Loai.toString().toLowerCase(); // Bản dùng để code check\n    }\n\n    // Trả về đúng chuẩn n8n\n    return { json: cleanData }; \n\n  } catch (error) {\n    // Nếu lỗi parse, trả về intent 'unknown' để workflow không chết hẳn (Crash)\n    return { \n        json: { \n            intent: \"error\", \n            error_msg: \"Lỗi cú pháp JSON từ AI: \" + error.message,\n            raw_text: rawContent\n        } \n    };\n  }\n} else {\n  // Không tìm thấy JSON -> Khả năng là AI chém gió linh tinh\n  return { \n      json: { \n          intent: \"chat_only\", \n          message: rawContent \n      } \n  };\n}"
      },
