    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nlet totalExpense = 0;\nlet listText = \"\";\nlet count = 0;\n\nfor (const item of items) {\n  const row = item.json;\n\n  // 1. Lọc: Chỉ lấy dòng có Loại là \"Chi tiêu\"\n  // Dùng toLowerCase() để bắt được cả \"Chi tiêu\", \"chi tiêu\", \"CHI TIÊU\"\n  const loai = (row['Loai'] || \"\").toString().toLowerCase().trim();\n  if (!loai.includes('chi tiêu')) continue;\n\n  // 2. Lấy dữ liệu (Đúng tên cột trong mẫu ông gửi)\n  const date = row['ThoiGian'] || \"N/A\"; \n  const content = row['Noi Dung'] || \"Chi tiêu\";\n  \n  // Xử lý tiền: Đảm bảo là số nguyên\n  const rawMoney = row['So Tien'] || 0;\n  const money = parseInt(rawMoney.toString().replace(/\\D/g, '')) || 0;\n\n  if (money === 0) continue;\n\n  // 3. Cộng dồn\n  totalExpense += money;\n  count++;\n  \n  const moneyStr = new Intl.NumberFormat('vi-VN').format(money);\n  listText += `- ${date}: ${content} 💸 **${moneyStr} đ**\\n`;\n}\n\n// 4. Kết quả\nlet finalText = `💸 **DANH SÁCH CHI TIÊU** (${count} khoản)\\n`;\nfinalText += `--------------------------------\\n`;\n\nif (count === 0) {\n    finalText += \"Không tìm thấy khoản chi tiêu nào trong dữ liệu.\";\n} else {\n    finalText += listText;\n    finalText += `\\n🔴 **TỔNG CỘNG: ${new Intl.NumberFormat('vi-VN').format(totalExpense)} đ**`;\n}\n\nreturn { json: { text: finalText } };"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        800,
        -64
      ],
      "id": "b88002c4-e241-48dd-ae79-41f1d43db054",
      "name": "Expense"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nlet totalDebt = 0;\nlet listText = \"\";\nlet count = 0;\n\nfor (const item of items) {\n  const row = item.json;\n\n  // 1. Lọc: Chỉ lấy dòng có Loại là \"Nợ\"\n  const loai = (row['Loai'] || \"\").toString().toLowerCase().trim();\n  // Lọc lấy chữ \"nợ\" (hoặc \"vay\" nếu ông có dùng từ này)\n  if (!loai.includes('nợ') && !loai.includes('vay')) continue;\n\n  // 2. Lấy dữ liệu\n  const date = row['ThoiGian'] || \"N/A\";\n  const content = row['Noi Dung'] || \"Khoản nợ\";\n  \n  // Lấy tên người (Quan trọng cho nhánh Nợ)\n  let person = row['Nguoi'] || \"\";\n  if (person) person = `(với ${person})`;\n\n  const rawMoney = row['So Tien'] || 0;\n  const money = parseInt(rawMoney.toString().replace(/\\D/g, '')) || 0;\n\n  if (money === 0) continue;\n\n  totalDebt += money;\n  count++;\n\n  const moneyStr = new Intl.NumberFormat('vi-VN').format(money);\n  \n  // Hiển thị: 13/12/2025: Mượn tiền (Ai đó) ⏳ 50.000 đ\n  listText += `- ${date}: ${content} ${person} ⏳ **${moneyStr} đ**\\n`;\n}\n\nlet finalText = `📝 **SỔ NỢ VAY - TRẢ** (${count} khoản)\\n`;\nfinalText += `--------------------------------\\n`;\n\nif (count === 0) {\n    finalText += \"Không tìm thấy khoản nợ nào.\";\n} else {\n    finalText += listText;\n    finalText += `\\n⚖️ **TỔNG GIÁ TRỊ: ${new Intl.NumberFormat('vi-VN').format(totalDebt)} đ**`;\n}\n\nreturn { json: { text: finalText } };"
      },
