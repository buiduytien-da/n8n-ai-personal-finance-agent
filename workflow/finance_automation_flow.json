    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\n// Header\nlet summaryText = `**TỔNG KẾT VÍ TIỀN (${new Date().toLocaleDateString('vi-VN').slice(0, 5)})** 🗓️\\n\\n`;\n\nfor (const item of items) {\n  const json = item.json;\n\n  // 1. LẤY DỮ LIỆU (Logic mới cho trường hợp đã Tắt Header)\n  // Khi tắt Header, n8n thường trả về key là \"A\", \"B\" hoặc \"0\", \"1\"\n  let label = json['A'] || json['0'] || json['Column A'] || \"\";\n  let value = json['B'] || json['1'] || json['Column B'] || 0;\n\n  // Logic dự phòng: Nếu không bắt được A/B thì quét mảng\n  if (!label || !value) {\n      // Lọc bỏ biến row_number (thủ phạm gây lỗi 2, 3, 4)\n      const cleanKeys = Object.keys(json).filter(k => k !== 'row_number' && k !== 'id');\n      \n      for (const k of cleanKeys) {\n          const v = json[k];\n          // Nếu là chữ dài -> Label\n          if (typeof v === 'string' && v.length > 2 && isNaN(v)) label = v;\n          // Nếu là số (và không phải row index bé xíu) hoặc chuỗi số -> Tiền\n          if ((typeof v === 'number' && v > 100) || (typeof v === 'string' && !isNaN(v))) value = v;\n      }\n  }\n\n  // Bỏ qua nếu không tìm được label hoặc tiền\n  if (!label || value === 0 || value === \"\") continue;\n\n  // 2. Xử lý số tiền\n  const moneyRaw = parseInt(value.toString().replace(/\\D/g, '')) || 0;\n  // Bỏ qua nếu tiền = 0 hoặc quá nhỏ (lọc nhiễu)\n  if (moneyRaw < 100) continue; \n  \n  const moneyStr = new Intl.NumberFormat('vi-VN').format(moneyRaw);\n\n  // 3. Logic Icon & Label (Map theo từ khóa trong cột A)\n  let icon = \"🔹\"; \n  let displayLabel = label;\n  const l = label.toString().toLowerCase();\n  \n  if (l.includes(\"thu\")) { \n      icon = \"📈\"; \n      displayLabel = \"Thu vào\"; \n  } else if (l.includes(\"chi\") || l.includes(\"tiêu\")) { \n      icon = \"💸\"; \n      displayLabel = \"Bay màu\"; \n  } else if (l.includes(\"nợ\")) { \n      icon = \"⏳\"; \n      displayLabel = \"Đang nợ\"; \n  } else if (l.includes(\"dư\") || l.includes(\"tồn\") || l.includes(\"két\")) { \n      icon = moneyRaw >= 0 ? \"💎\" : \"🚩\"; \n      displayLabel = \"Két sắt còn\"; \n  }\n\n  // 4. Ghép dòng (Có \\n\\n để xuống dòng chắc chắn)\n  summaryText += `${icon} ${displayLabel}: **${moneyStr} đ**\\n\\n`;\n}\n\nsummaryText += \"💬 *Note: Nhớ check kỹ trước khi xuống tay tiêu nhé!*\";\n\nreturn {\n  json: {\n    text: summaryText \n  }\n};"
      },
