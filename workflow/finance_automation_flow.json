    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nlet totalIncome = 0;\nlet listText = \"\";\nlet count = 0;\n\nfor (const item of items) {\n  const row = item.json;\n\n  // Sheet Thu Nhập không cần lọc 'Loai', lấy tất cả\n  const date = row['Thoi Gian'] || row['ThoiGian'] || \"N/A\"; // Chú ý cột có dấu cách\n  const content = row['Noi Dung'] || row['Noi_Dung'] || \"Thu nhập\";\n  \n  const rawMoney = row['So Tien'] || row['SoTien'] || 0;\n  const money = parseInt(rawMoney.toString().replace(/\\D/g, '')) || 0;\n\n  if (money === 0) continue;\n\n  totalIncome += money;\n  count++;\n\n  const moneyStr = new Intl.NumberFormat('vi-VN').format(money);\n\n  listText += `- *${date}*: ${content} 🤑 **+${moneyStr} đ**\\n`;\n}\n\nlet finalText = `💎 **LÚA VỀ LÀNG (THU NHẬP)**\\n`;\nfinalText += `--------------------------------\\n`;\n\nif (count === 0) {\n    finalText += \"🍂 Đói kém quá, chưa thấy đồng nào về...\";\n} else {\n    finalText += listText;\n    finalText += `\\n💰 **TỔNG THU VỀ: ${new Intl.NumberFormat('vi-VN').format(totalIncome)} đ**`;\n}\n\nreturn { json: { text: finalText } };"
      },
